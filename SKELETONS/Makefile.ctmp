#------------------------------------------------------------------------
#
# File  : Makefile template for a library directory
#
# E is built by the top level Makefile, where the objects of a new
# library XXX have to be listed (XXX_OBJ), together with a rule for
# XXX/XXX.a and an entry in ELIBS. The directory itself only gets
# this forwarding Makefile.
#
#------------------------------------------------------------------------

all:
	cd .. && $(MAKE) XXX/XXX.a

.DEFAULT:
	cd .. && $(MAKE) $@

clean:
	rm -f *.o *.a
