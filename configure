#!/bin/sh -f
########################################################################
#
# File: configure
#
# Copyright 2008-2026 Stephan Schulz, schulz@eprover.org
#
# Configuration script for the equational theorem prover E.
#
# Usage:
#
# Change directory to the top level directory of the E distribution
# (where this file is located). Then run
#
# ./configure
#
# This will prepare E for compilation in place, i.e. it will compile
# the system in place and configure programs and scripts to find the
# execuable in the directory E/PROVER. Installation in this way will
# not affect any files outside the E distribution directory.
#
# If you want to install E in a special place in the file system, run
#
# ./configure --bindir=/path/to/executables
#
# The configuration is written to config.mk (which is only changed if
# the configuration changes), and the header dependencies to deps.mk.
#
# After running the configure script, you will usually type
#
# make
#
# to compile E and build all the executables. To actually install E
# somewhere outside its build directory, type
#
# make install
#
# You will need the necessary access rights to move the executables
# and possibly to create the requested directory.
#
# Have Fun!
#
# This code is part of the support structure for the equational
# theorem prover E. Visit
#
#  https://www.eprover.org
#
# for more information.
#
# This program is free software; you can redistribute it and/or modify
# it under the terms of the GNU General Public License as published by
# the Free Software Foundation; either version 2 of the License, or
# (at your option) any later version.
#
# This program is distributed in the hope that it will be useful,
# but WITHOUT ANY WARRANTY; without even the implied warranty of
# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
# GNU General Public License for more details.
#
# You should have received a copy of the GNU General Public License
# along with this program ; if not, write to the Free Software
# Foundation, Inc., 59 Temple Place, Suite 330, Boston,
# MA  02111-1307 USA
#
# The original copyright holder can be contacted as
#
# Stephan Schulz
# DHBW Stuttgart
# Fakultät Technik/Informatik
# Lerchenstraße 1
# 70174 Stuttgart
# GERMANY
#
# or, preferably, via email (address above).
#

EXECPATH=`pwd`/PROVER
MANPATH=`pwd`/DOC/man

eprover_bin=eprover
enable_ho=""
unix_comments=""
debug=no
config_args=""

for argument in "$@"; do
    opt=`echo "$argument"|cut -d= -f1`
    arg=`echo "$argument"|cut -d= -f2-`
    case "$opt" in
        -h|--help)
            echo "Usage: ./configure [options]"
            echo ""
            echo "Supported options:"
            echo "--help"
            echo "  Print this help."
            echo "--enable-ho"
            echo "  Build E with support for higher-order logic."
            echo "--unix-comments"
            echo "  Build E to use # as the start comment character."
            echo "--debug"
            echo "  Build E with assertions and memory debugging."
            echo "--bindir=<path>"
            echo "  Configure E for running from <path>".
            echo "--exec-prefix=<path>"
            echo "  Equivalent to --bindir=<path>/bin".
            echo "--man-prefix=<path>"
            echo "  Specify directory for the man pages."
            echo "--prefix=<path>"
            echo "  Equivalent to --bindir=<path>/bin --man-prefix=<path>/man".
            exit 0
            ;;
        --bindir)
            EXECPATH=$arg
            ;;
        --enable-ho)
            enable_ho="-DENABLE_LFHO"
            eprover_bin=eprover-ho
            ;;
        --enable-lfho)
            enable_ho="-DENABLE_LFHO"
            eprover_bin=eprover-ho
            echo "Obsolete option tolerated. Use --enable-ho in the future."
            ;;
        --unix-comments)
            unix_comments="-DUNIX_COMMENTS"
            ;;
        --debug)
            debug=yes
            ;;
        --exec-prefix)
            EXECPATH=$arg/bin
            ;;
        --man-prefix)
            MANPATH=$arg
            ;;
        --prefix)
            EXECPATH=$arg/bin
            MANPATH=$arg/man
            ;;
        *)
            echo "Unknown option " $argument
            exit 1
            ;;
    esac
    if [ "$opt" != "--debug" ] ; then
        config_args="$config_args $argument"
    fi
done

if [ $debug = yes ] ; then
    nodebug=""
    memdebug="-DCLB_MEMORY_DEBUG"
else
    nodebug="-DNDEBUG -DFAST_EXIT"
    memdebug=""
fi

echo "Configuring with executable path "$EXECPATH
echo "Configuring with man path "$MANPATH

cat > config.mk.tmp <<EOT
# Build configuration, written by ./configure. Do not edit, rerun
# ./configure instead.

CONFIG_ARGS = $config_args
EXECPATH    = $EXECPATH
MANPATH     = $MANPATH
EPROVER_BIN = $eprover_bin
CONFIGFLAGS = $enable_ho $unix_comments
NODEBUG     = $nodebug
MEMDEBUG    = $memdebug
EOT

# Only replace config.mk if it changes, as everything depends on it.
if cmp -s config.mk.tmp config.mk ; then
    rm config.mk.tmp
else
    mv config.mk.tmp config.mk
fi

# The Makefile includes deps.mk, so it has to exist for make depend.
if [ ! -f deps.mk ] ; then
    : > deps.mk
fi
${MAKE:-make} depend
